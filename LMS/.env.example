# Copy this file to .env and fill in real values for your environment.
# .env is already listed in .gitignore - never commit your actual secrets.

# A long, random, unpredictable string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Set to False in any deployed/production environment.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to a local SQLite file if unset. Production deployments (and the
# Docker setup) use PostgreSQL - see docker-compose.production.yml, which
# reads DATABASE_URL like:
#   DATABASE_URL=postgres://lms:CHANGE_ME@db:5432/lms
# (only docker-compose.production.yml also needs POSTGRES_PASSWORD set,
# matching the password in this URL, to initialize the database container.)
DATABASE_URL=sqlite:///db.sqlite3
# POSTGRES_PASSWORD=change-me

# Email - only needed for the password-reset flow. In development, emails
# print to the console by default and none of this needs to be set. In
# production, set real SMTP credentials, e.g. for Gmail:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=your-address@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=your-address@gmail.com

# Organization name, branding colors, address/hours, loan policy, and
# feature toggles are configured per-deployment in the database, not here -
# see Django admin > Library settings (or `python manage.py setup_organization`
# for first-time setup of a new deployment).
