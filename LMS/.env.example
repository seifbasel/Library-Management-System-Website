# Copy this file to .env and fill in real values for your environment.
# .env is already listed in .gitignore - never commit your actual secrets.

# A long, random, unpredictable string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Set to False in any deployed/production environment.
DEBUG=True

# Comma-separated list of hostnames this site is allowed to serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults to a local SQLite file if unset. To use Postgres instead, set e.g.:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# Email - only needed for the password-reset flow. In development, emails
# print to the console by default and none of this needs to be set. In
# production, set real SMTP credentials, e.g. for Gmail:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=your-address@gmail.com
#   EMAIL_HOST_PASSWORD=your-app-password
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=your-address@gmail.com

# Shown on the homepage and footer ("Visit us" / "Follow us"). All optional -
# sensible placeholders are used if unset.
# LIBRARY_NAME=LMS Library
# LIBRARY_ADDRESS=123 Main Street, Springfield
# LIBRARY_HOURS=Mon-Fri 9am-8pm, Sat-Sun 10am-5pm
# LIBRARY_PHONE=(555) 010-0110
# LIBRARY_EMAIL=hello@lms-library.example
# SOCIAL_INSTAGRAM=https://instagram.com/yourlibrary
# SOCIAL_TWITTER=https://x.com/yourlibrary
# SOCIAL_FACEBOOK=https://facebook.com/yourlibrary
